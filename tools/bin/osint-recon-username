#!/usr/bin/env bash
# osint-recon-username <pseudo>
# Balaie un pseudo sur des plateformes sociales / dev / forums (passif).
set -uo pipefail
. /opt/osint/lib/common.sh

TARGET="${1:-}"; require_target "$TARGET"
TARGET="${TARGET#@}"
RUNDIR="$(new_run username "$TARGET")"
cd "$RUNDIR/raw" || die "impossible d'entrer dans le répertoire d'exécution"
log "balayage de pseudo → $TARGET"

if have sherlock; then
  run_sh sherlock sherlock.txt \
    "sherlock --no-color --print-found --timeout 15 --folderoutput '$RUNDIR/raw/sherlock_d' '$TARGET' || true; \
     cat '$RUNDIR/raw/sherlock_d/$TARGET.txt' 2>/dev/null"
fi

if have maigret; then
  run_sh maigret maigret.txt \
    "maigret '$TARGET' --no-progressbar --timeout 15 -T 20 -fo '$RUNDIR/raw/maigret_d' -J ndjson -C -H 2>/dev/null; \
     maigret '$TARGET' --no-progressbar --timeout 15 -T 20 -fo '$RUNDIR/raw/maigret_d' -J simple 2>/dev/null; \
     cat '$RUNDIR/raw/maigret_d'/report_${TARGET}_simple.json 2>/dev/null"
  cp "$RUNDIR/raw/maigret_d"/report_"${TARGET}".html "$RUNDIR/maigret.html" 2>/dev/null || true
fi

if have blackbird; then
  run_sh blackbird blackbird.json \
    "blackbird --username '$TARGET' --json --no-update --timeout 15 2>/dev/null; \
     cat ~/blackbird/results/*${TARGET}*.json 2>/dev/null || true"
fi

have socialscan && run socialscan socialscan.json -- socialscan "$TARGET" --json "$RUNDIR/raw/socialscan.json"

run_sh github-profile github.json "oget https://api.github.com/users/$TARGET"
run_sh gitlab-profile gitlab.json "oget 'https://gitlab.com/api/v4/users?username=$TARGET'"
run_sh keybase keybase.json "oget 'https://keybase.io/_/api/1.0/user/lookup.json?usernames=$TARGET'"

{ for d in gmail.com outlook.com proton.me yahoo.com icloud.com; do echo "${TARGET}@${d}"; done; } >candidate-emails.txt

finish_run
