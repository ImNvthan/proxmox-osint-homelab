# /etc/osint/osint.env — copié ici à l'installation (mode 0600). À éditer librement.
# TOUTES les clés sont FACULTATIVES : le homelab fonctionne sans aucune, sur des
# sources publiques sans clé. Après édition :  osint doctor

# ============ Comportement de l'autopilote ==============================
OSINT_REGION="FR"                 # région par défaut pour parser les numéros
OSINT_AUTO_MAX_DEPTH="2"          # profondeur de pivot (0 = juste la cible)
OSINT_AUTO_MAX_NODES="40"         # budget d'entités explorées par enquête
OSINT_AUTO_MIN_CONF="0.55"        # confiance minimale pour pivoter sur un sélecteur
OSINT_STEP_TIMEOUT="600"          # secondes par outil avant kill
OSINT_HTTP_PORT="8899"            # `osint serve`
OSINT_WEB_PORT="8080"             # interface web

# ============ Données personnelles / RGPD ===============================
# Recherche de la FAMILLE / des PROCHES : désactivée par défaut. La passer à 1
# vaut déclaration que vous avez une base légale pour traiter des données de
# TIERS (art. 6 RGPD). Voir docs/LEGAL.md.
OSINT_ALLOW_RELATIONS="0"
# Purge automatique des enquêtes après N jours (0 = jamais). Active la limitation
# de conservation. Pensez aussi à : systemctl enable --now osint-case-gc.timer
OSINT_CASE_TTL_DAYS="0"

# ============ Interface web ============================================
# Auth Basic optionnelle (vide = pas d'auth ; à réserver au LAN de confiance)
OSINT_WEB_USER=""
OSINT_WEB_PASS=""

# ============ Recherche web (osint person / relations) ================
# Priorité : Google CSE (100 req/jour gratuit) > SerpAPI (100/mois) > DuckDuckGo
# HTML (sans clé, mais souvent bloqué depuis un datacenter/VPS).
# Google Programmable Search :
#   1) https://programmablesearchengine.google.com/  -> créer un moteur,
#      activer « Rechercher sur tout le Web », copier l'ID (cx).
#   2) https://console.cloud.google.com/  -> API « Custom Search API » -> activer
#      -> Identifiants -> Clé API. (quota 100/jour gratuit)
GOOGLE_CSE_KEY=""                 # clé API Google Cloud
GOOGLE_CSE_CX=""                  # ID du moteur (cx)
# SerpAPI : https://serpapi.com/  -> inscription -> Dashboard -> Api Key (100/mois)
SERPAPI_KEY=""

# ============ Fuites / exposition =====================================
HIBP_API_KEY=""                   # haveibeenpwned.com  (osint email)
DEHASHED_EMAIL=""                 # dehashed.com        (h8mail)
DEHASHED_KEY=""

# ============ Infra / hôtes ===========================================
SHODAN_API_KEY=""                 # shodan.io           (osint ip, SpiderFoot)
GREYNOISE_API_KEY=""              # greynoise.io        (osint ip)
SECURITYTRAILS_API_KEY=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""
BINARYEDGE_API_KEY=""
VIRUSTOTAL_API_KEY=""
INTELX_API_KEY=""

# ============ Personnes / e-mails / domaines ==========================
HUNTER_API_KEY=""                 # hunter.io
GITHUB_TOKEN=""                   # PAT sans scope — relève les limites d'API

# ============ Notifications (osint-monitor) ===========================
#   ntfy :  OSINT_NOTIFY_CMD='xargs -0 -I{} curl -s -d {} https://ntfy.sh/mon-sujet'
#   slack : OSINT_NOTIFY_CMD='xargs -0 -I{} curl -s -X POST -H "Content-type: application/json" -d "{\"text\":\"{}\"}" $SLACK_WEBHOOK'
OSINT_NOTIFY_CMD=""
